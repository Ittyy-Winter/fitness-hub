# Copy to .env and fill in. .env is gitignored.

# Pinned openGym image version (ghcr.io/duartesantos8/opengym-{api,web}).
# Bump deliberately: openGym API changes can break the gym sync.
OPENGYM_VERSION=1.4.1

# Public hostname for openGym. Passkeys are bound to this exact name:
# changing it later makes every registered passkey stop working.
GYM_HOST=gym.example.com
GYM_LOCAL_PORT=8080

# Set to 1 after registering your own profile.
OPENGYM_INVITE_ONLY=0

POSTGRES_PASSWORD=change-me

# From Cloudflare Zero Trust → Networks → Tunnels → your tunnel → install command.
CLOUDFLARE_TUNNEL_TOKEN=
# Uncomment once the token above is set.
# COMPOSE_PROFILES=tunnel

# Nightly backup (scripts/backup.sh). Leave empty to keep backups on this machine only.
# Any rclone remote path, e.g. gdrive:fitness-hub-backup or r2:bucket/fitness-hub
BACKUP_RCLONE_REMOTE=
BACKUP_KEEP_DAYS=14

# Google Health OAuth client (Google Cloud Console → Google Auth Platform → Clients).
# Redirect URI to register: http://localhost:8081/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
HUB_LOCAL_PORT=8081

# 32-byte hex key that encrypts OAuth tokens in Postgres. Generate with: openssl rand -hex 32
# Losing it only means re-doing the Google consent once.
HUB_ENCRYPTION_KEY=
